*.tsbuildinfo
next-env.d.ts

# Local secrets and environment files
.env*
!.env.example
!.env.bitcoin.example
.env.signet.backup
ADD_TO_ENV_LOCAL.txt

# Local runtime, test artifacts and editor backups
/supabase/.temp/
/tmp-escrow-test/
*.bak
*.pre-fix.bak
*.bak-phase*
